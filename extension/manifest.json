{
  "manifest_version": 3,
  "name": "AWS STS Keys (Keycloak SSO)",
  "short_name": "AWS STS Keys",
  "version": "1.2.0",
  "description": "Lists every AWS account and role from your Keycloak sign-in, and issues temporary credentials for the one you pick.",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://signin.aws.amazon.com/saml",
    "https://sts.amazonaws.com/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AWS STS Keys",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
